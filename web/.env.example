# Kopier relevante linjer til .env.local (aldri sjekk inn hemmeligheter).

NEXT_PUBLIC_SANITY_PROJECT_ID=qv34pyof
NEXT_PUBLIC_SANITY_DATASET=production

# Visuell redigering (Draft Mode): token med rolle «Viewer».
SANITY_API_READ_TOKEN=

# Kontaktskjemaet trenger minst én av disse leveringsmåtene:
#
# 1) Lagre henvendelsene i Sanity (vises under «Henvendelser» i Studio).
#    Token med skrivetilgang: manage.sanity.io -> API -> Tokens -> rolle «Editor».
#    OBS: Datasettet er offentlig. Henvendelsene lagres derfor som utkast (aldri
#    publisert), som ikke kan leses uten token. Publiser dem aldri.
SANITY_API_WRITE_TOKEN=
#
# 2) Få e-post for hver henvendelse (Resend, resend.com).
#    CONTACT_FROM_EMAIL må være en adresse på et domene du har verifisert hos Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Hubro Digital <kontakt@hubrodigital.no>

# Bare for testing av skjemaet: svarer «sendt» uten å levere noe.
# CONTACT_DRY_RUN=true

# Resultater (/resultater) og kundecase (/case/...) er skrudd av som standard.
# Sett til true for å vise dem igjen (krever ny bygging).
# NEXT_PUBLIC_ENABLE_CASES=true

# Passordbeskyttelse av hele nettsiden (HTTP Basic). Sett i Vercel (Production og Preview)
# når siden ikke skal være åpen. La stå tomt lokalt og når siden skal være åpen.
# Brukernavnet kan være hva som helst; bare passordet sjekkes.
# SITE_PASSWORD=

# Indeksering: søkemotorer er stengt ute som standard (noindex). Sett til true når
# nettsiden skal bli synlig i Google.
# ALLOW_INDEXING=true
